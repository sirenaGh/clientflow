{
  "name": "clientflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "setup:local": "node scripts/local-setup.mjs",
    "test:prepare": "node scripts/test-database.mjs",
    "test": "node scripts/integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "demo:cleanup": "npm run demo:cleanup -w server",
    "start": "npm run start -w server",
    "build:production": "npm run db:generate && npm run build",
    "demo:cleanup:production": "node server/dist/src/cleanup-demos.js",
    "test:production": "node scripts/production-smoke.mjs",
    "start:render": "node scripts/start-render.mjs",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "test:tls": "node scripts/tls-ci.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
