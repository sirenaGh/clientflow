DATABASE_URL=mysql://clientflow:CHANGE_ME@127.0.0.1:3306/clientflow
TEST_DATABASE_URL=mysql://clientflow:CHANGE_ME@127.0.0.1:3306/clientflow_test
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
NODE_ENV=development
# Set these locally before running db:seed (minimum 12 characters each).
SEED_ADMIN_PASSWORD=
SEED_SALES_ONE_PASSWORD=
SEED_SALES_TWO_PASSWORD=
# Optional: pre-created separate database for review captures on another MySQL setup.
# REVIEW_DATABASE_URL=mysql://clientflow:CHANGE_ME@127.0.0.1:3306/clientflow_review_test

# Disabled by default. Set true only when deliberately enabling visitor access.
DEMO_ENABLED=false
