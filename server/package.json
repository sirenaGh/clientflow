{
  "name": "@clientflow/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:cleanup": "tsx src/cleanup-demos.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-mariadb": "^7.0.0",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0",
    "argon2": "^0.44.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.0",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0"
  }
}
